server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    # Game WebSocket -> backend service. BACKEND_URL is e.g. https://arrow-chase-api-xyz.a.run.app
    location /ws {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Cloud Run routes by Host, so send the backend's own host name, and SNI for TLS.
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Long-lived game connections; Cloud Run's own request timeout (max 3600 s) also applies.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Hashed build assets never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
